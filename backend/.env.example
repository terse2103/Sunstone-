# Required for live LLM rationale + intervention briefs.
# If unset or invalid, the backend falls back to deterministic templated strings.
ANTHROPIC_API_KEY=

# Comma-separated origins permitted by CORS (FastAPI reads this in main.py).
# Local dev only — production runs frontend + backend on the same Vercel origin,
# so this variable is unused in prod and can stay unset there.
ALLOWED_ORIGINS=http://localhost:5173
